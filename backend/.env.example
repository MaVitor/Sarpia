# Django — desenvolvimento local
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend autorizado a acessar a API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gemini — preencher no .env quando as credenciais estiverem disponíveis
# Para mais de uma chave autorizada, separar por virgula.
GEMINI_API_KEYS=
GEMINI_MODEL=

# Limites de entrada
MAX_PDF_MB=8
MAX_PAGINAS=20
MAX_CARACTERES_MATERIAL=50000
MAX_CARACTERES_ENSAIO=30000

# Integracao com Gemini
# Timeout em milissegundos: 60000 = 60 segundos.
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_TENTATIVAS=2