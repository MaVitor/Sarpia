# Chaves da API Gemini separadas por vírgula (idealmente de projetos Google Cloud diferentes,
# pois os limites do free tier são por projeto, não por chave)
GEMINI_API_KEYS=cole-chave-1,cole-chave-2
GEMINI_MODEL=gemini-3.6-flash
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
DJANGO_DEBUG=true
CORS_ORIGINS=http://localhost:5173
MAX_PDF_MB=8
MAX_PAGINAS=20
