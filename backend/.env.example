# Django — desenvolvimento local
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173

# Banco de dados — PostgreSQL
# Deixar POSTGRES_DB vazio para continuar usando SQLite no desenvolvimento local
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend autorizado a acessar a API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Conta e sessão
ACCOUNT_EMAIL_VERIFICATION=optional
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Gemini — preencher no .env quando as credenciais estiverem disponíveis
# Para mais de uma chave autorizada, separar por virgula.
GEMINI_API_KEYS=
GEMINI_MODEL=

# Limites de entrada
MAX_PDF_MB=8
MAX_PAGINAS=20
MAX_CARACTERES_MATERIAL=50000
MAX_CARACTERES_ENSAIO=30000

# Integracao com Gemini
# Timeout por chamada ao SDK, em milissegundos: 60000 = 60 segundos.
# O SDK usa uma tentativa de rede; a aplicação pode repetir apenas 503.
GEMINI_TIMEOUT_MS=60000
# Máximo de tentativas da aplicação, incluindo a primeira chamada.
GEMINI_MAX_TENTATIVAS=2
# Orçamento total aproximado da operação, incluindo as tentativas da aplicação.
GEMINI_ORCAMENTO_MS=65000
# Identificadores locais opcionais, na mesma ordem das chaves; não são segredos.
GEMINI_KEY_PROJECTS=